{
  "manifest_version": 2,
  "name": "timesink sites",
  "version": "0.1.0",
  "description": "Tells your local timesink which website (domain only) is in the active tab. Nothing leaves your computer.",
  "browser_specific_settings": {
    "gecko": {
      "id": "timesink-sites@timesink",
      "strict_min_version": "109.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "permissions": ["tabs", "nativeMessaging"],
  "incognito": "not_allowed",
  "background": { "scripts": ["background.js"] }
}
